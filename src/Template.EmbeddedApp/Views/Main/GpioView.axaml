<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.EmbeddedApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.EmbeddedApp.Views.Main.GpioView"
             x:DataType="local:GpioViewModel"
             s:DataContextResolver.Type="local:GpioViewModel"
             d:DesignWidth="800" d:DesignHeight="480">

    <UserControl.Styles>
        <Style Selector="Border.pin">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="Border.pin.power3">
            <Setter Property="Background" Value="{StaticResource OrangeLighten3}" />
        </Style>
        <Style Selector="Border.pin.power5">
            <Setter Property="Background" Value="{StaticResource RedLighten3}" />
        </Style>
        <Style Selector="Border.pin.ground">
            <Setter Property="Background" Value="{StaticResource GrayLighten1}" />
        </Style>
        <Style Selector="Border.pin TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.level">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource GrayLighten1}" />
        </Style>
        <Style Selector="Ellipse.level.high">
            <Setter Property="Fill" Value="{StaticResource GreenDefault}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="8"
          RowSpacing="8">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12">
            <TextBlock Text="GPIO"
                       Classes="title" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding PageText}"
                       FontSize="20" />
            <TextBlock VerticalAlignment="Center"
                       Text="pin / level / name / function"
                       Classes="note" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding !IsSupported}"
                       Text="Raspberry Pi only"
                       Classes="note" />
        </StackPanel>

        <ItemsControl Grid.Row="1"
                      VerticalAlignment="Top"
                      ItemsSource="{Binding PagePins}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" RowSpacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:GpioPinItem">
                    <Border Classes="pin"
                            Classes.ground="{Binding IsGround}"
                            Classes.power3="{Binding IsPower3V3}"
                            Classes.power5="{Binding IsPower5V}">
                        <Grid ColumnDefinitions="40,24,*,64">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PhysicalPin}"
                                       FontWeight="Bold" />
                            <Ellipse Grid.Column="1"
                                     IsVisible="{Binding SocPin, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Classes="level"
                                     Classes.high="{Binding IsHigh}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       Text="{Binding Function}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="6">
            <Border Classes="hint">
                <TextBlock Text="A: next page" />
            </Border>
            <Border Classes="hint">
                <TextBlock Text="B: previous page" />
            </Border>
        </StackPanel>
    </Grid>

</UserControl>
