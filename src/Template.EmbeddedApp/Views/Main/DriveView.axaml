<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.EmbeddedApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.EmbeddedApp.Views.Main.DriveView"
             x:DataType="local:DriveViewModel"
             s:DataContextResolver.Type="local:DriveViewModel"
             d:DesignWidth="800" d:DesignHeight="480">

    <UserControl.Styles>
        <Style Selector="Ellipse.link">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource GrayLighten1}" />
        </Style>
        <Style Selector="Ellipse.link.connected">
            <Setter Property="Fill" Value="{StaticResource GreenDefault}" />
        </Style>
        <Style Selector="Ellipse.link.unsupported">
            <Setter Property="Fill" Value="{StaticResource AmberDefault}" />
        </Style>
        <Style Selector="Ellipse.link.fault">
            <Setter Property="Fill" Value="{StaticResource RedDefault}" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.hat">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="8"
          RowSpacing="8">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="Drive"
                       Classes="title" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="Build HAT"
                           Classes="hat" />
                <Ellipse Classes="link"
                         Classes.connected="{Binding IsHatConnected}"
                         Classes.fault="{Binding IsPowerFault}" />
                <TextBlock Text="{Binding HatState}"
                           Classes="hat" />
                <TextBlock Text="{Binding HatDetail}"
                           Classes="hat label" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">
            <Border Grid.Column="0"
                    Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding DriveTitle}"
                               Classes="card-title" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Ellipse Grid.Column="0"
                                 Classes="link"
                                 Classes.connected="{Binding IsDriveConnected}"
                                 Classes.unsupported="{Binding IsDriveUnsupported}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DriveName}"
                                   FontSize="20"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{Binding Direction}"
                               Classes="state" />
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="90,*,96"
                          ColumnSpacing="6" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Target"
                                   Classes="label" />
                        <ProgressBar Grid.Row="0" Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Value="{Binding TargetSpeed}"
                                     Maximum="100" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TargetSpeedText}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Actual"
                                   Classes="label" />
                        <ProgressBar Grid.Row="1" Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Value="{Binding ActualSpeed}"
                                     Maximum="100" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActualSpeedText}" />
                    </Grid>
                    <TextBlock Text="{Binding DrivePosition, StringFormat='Position  {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SteeringTitle}"
                               Classes="card-title" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Ellipse Grid.Column="0"
                                 Classes="link"
                                 Classes.connected="{Binding IsSteeringConnected}"
                                 Classes.unsupported="{Binding IsSteeringUnsupported}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SteeringName}"
                                   FontSize="20"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{Binding SteeringState}"
                               Classes="state" />
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="90,*,96"
                          ColumnSpacing="6" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Target"
                                   Classes="label" />
                        <Slider Grid.Row="0" Grid.Column="1"
                                IsEnabled="False"
                                Value="{Binding TargetAngle}"
                                Minimum="{Binding MinAngle}"
                                Maximum="{Binding MaxAngle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TargetAngleText}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Actual"
                                   Classes="label" />
                        <Slider Grid.Row="1" Grid.Column="1"
                                IsEnabled="False"
                                Value="{Binding ActualAngle}"
                                Minimum="{Binding MinAngle}"
                                Maximum="{Binding MaxAngle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActualAngleText}" />
                    </Grid>
                    <TextBlock Text="{Binding SteeringAbsolute, StringFormat='Absolute  {0}'}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="6">
            <Border Classes="hint"
                    Classes.on="{Binding Accel}">
                <TextBlock Text="A: accel" />
            </Border>
            <Border Classes="hint"
                    Classes.on="{Binding Brake}">
                <TextBlock Text="B: brake" />
            </Border>
        </StackPanel>
    </Grid>

</UserControl>
