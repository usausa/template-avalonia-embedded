<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.EmbeddedApp.Views.Main"
             xmlns:converters="clr-namespace:Template.EmbeddedApp.Converters"
             mc:Ignorable="d"
             x:Class="Template.EmbeddedApp.Views.Main.DriveView"
             x:DataType="local:DriveViewModel"
             s:DataContextResolver.Type="local:DriveViewModel"
             d:DesignWidth="800" d:DesignHeight="480">

    <UserControl.Resources>
        <converters:MotorNameConverter x:Key="MotorNameConverter" />
        <s:MapToTextConverter x:Key="SteeringConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static local:SteeringDirection.Center}"
                                  Value="Center" />
                <s:MapToTextEntry Key="{x:Static local:SteeringDirection.Left}"
                                  Value="Left" />
                <s:MapToTextEntry Key="{x:Static local:SteeringDirection.Right}"
                                  Value="Right" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Ellipse.link">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource GrayLighten1}" />
        </Style>
        <Style Selector="Ellipse.link.connected">
            <Setter Property="Fill" Value="{StaticResource GreenDefault}" />
        </Style>
        <Style Selector="Ellipse.link.unsupported">
            <Setter Property="Fill" Value="{StaticResource AmberDefault}" />
        </Style>
        <Style Selector="Ellipse.link.fault">
            <Setter Property="Fill" Value="{StaticResource RedDefault}" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.hat">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="8"
          RowSpacing="8">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="Drive"
                       Classes="title" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="Build HAT"
                           Classes="hat" />
                <Ellipse Classes="link"
                         Classes.connected="{Binding IsHatConnected}"
                         Classes.fault="{Binding IsPowerFault}" />
                <TextBlock IsVisible="{Binding !IsPowerFault}"
                           Text="{Binding HatCondition}"
                           Classes="hat" />
                <TextBlock IsVisible="{Binding IsPowerFault}"
                           Text="Power fault"
                           Classes="hat" />
                <TextBlock IsVisible="{Binding HatVoltage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding HatVoltage, StringFormat='{}{0:F1} V'}"
                           Classes="hat label" />
                <TextBlock IsVisible="{Binding FirmwareDate, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding FirmwareDate, StringFormat='fw {0}'}"
                           Classes="hat label" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">
            <Border Grid.Column="0"
                    Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding DrivePort, StringFormat='{}{0}  Drive'}"
                               Classes="card-title" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Ellipse Grid.Column="0"
                                 Classes="link"
                                 Classes.connected="{Binding IsDriveConnected}"
                                 Classes.unsupported="{Binding IsDriveUnsupported}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DriveMotor, Converter={StaticResource MotorNameConverter}}"
                                   FontSize="20"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{Binding IsForward, Converter={s:BoolToText True=Forward, False=Stopped}}"
                               Classes="state" />
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="90,*,96"
                          ColumnSpacing="6" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Target"
                                   Classes="label" />
                        <ProgressBar Grid.Row="0" Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Value="{Binding TargetSpeed}"
                                     Maximum="100" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TargetSpeed, StringFormat='{}{0} %'}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Actual"
                                   Classes="label" />
                        <ProgressBar Grid.Row="1" Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Value="{Binding ActualSpeed}"
                                     Maximum="100" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding DriveSpeed, StringFormat='{}{0} %', TargetNullValue=-}" />
                    </Grid>
                    <TextBlock Text="{Binding DrivePosition, StringFormat='Position  {0} deg', TargetNullValue='Position  -'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SteeringPort, StringFormat='{}{0}  Steering'}"
                               Classes="card-title" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Ellipse Grid.Column="0"
                                 Classes="link"
                                 Classes.connected="{Binding IsSteeringConnected}"
                                 Classes.unsupported="{Binding IsSteeringUnsupported}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SteeringMotor, Converter={StaticResource MotorNameConverter}}"
                                   FontSize="20"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{Binding SteeringDirection, Converter={StaticResource SteeringConverter}}"
                               Classes="state" />
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="90,*,96"
                          ColumnSpacing="6" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Target"
                                   Classes="label" />
                        <Slider Grid.Row="0" Grid.Column="1"
                                IsEnabled="False"
                                Value="{Binding TargetAngle}"
                                Minimum="{Binding MinAngle}"
                                Maximum="{Binding MaxAngle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TargetAngle, StringFormat='{}{0} deg'}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Actual"
                                   Classes="label" />
                        <Slider Grid.Row="1" Grid.Column="1"
                                IsEnabled="False"
                                Value="{Binding ActualAngle}"
                                Minimum="{Binding MinAngle}"
                                Maximum="{Binding MaxAngle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding SteeringAngle, StringFormat='{}{0} deg', TargetNullValue=-}" />
                    </Grid>
                    <TextBlock Text="{Binding SteeringAbsolute, StringFormat='Absolute  {0} deg', TargetNullValue='Absolute  -'}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="6">
            <Border Classes="hint"
                    Classes.on="{Binding Accel}">
                <TextBlock Text="A: accel" />
            </Border>
            <Border Classes="hint"
                    Classes.on="{Binding Brake}">
                <TextBlock Text="B: brake" />
            </Border>
        </StackPanel>
    </Grid>

</UserControl>
