<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.EmbeddedApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.EmbeddedApp.Views.Main.TypographyView"
             x:DataType="local:TypographyViewModel"
             s:DataContextResolver.Type="local:TypographyViewModel"
             d:DesignWidth="800" d:DesignHeight="480">

    <UserControl.Styles>
        <Style Selector="TextBlock.name">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource GrayDarken1}" />
        </Style>
        <Style Selector="TextBlock.sample">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="150,*"
          Margin="8"
          RowSpacing="6">

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Typography"
                   Classes="title" />

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Inter 24"
                   Classes="name" />
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="The quick brown fox jumps over the lazy dog."
                   FontSize="24"
                   Classes="sample" />

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Inter 36"
                   Classes="name" />
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="Quick brown fox 0123456789"
                   FontSize="36"
                   Classes="sample" />

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Inter weight"
                   Classes="name" />
        <StackPanel Grid.Row="3" Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="20">
            <TextBlock Text="Light"
                       FontSize="36"
                       FontWeight="Light" />
            <TextBlock Text="Regular"
                       FontSize="36" />
            <TextBlock Text="SemiBold"
                       FontSize="36"
                       FontWeight="SemiBold" />
            <TextBlock Text="Bold"
                       FontSize="36"
                       FontWeight="Bold" />
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="851Gkktt 36"
                   Classes="name" />
        <TextBlock Grid.Row="4" Grid.Column="1"
                   Text="組み込み機器の画面 100"
                   FontFamily="{StaticResource Gkktt}"
                   FontSize="36"
                   Classes="sample" />

        <TextBlock Grid.Row="5" Grid.Column="0"
                   Text="DSEG7 48"
                   Classes="name" />
        <TextBlock Grid.Row="5" Grid.Column="1"
                   Text="12:34 88.8"
                   FontFamily="{StaticResource Dseg7}"
                   FontSize="48"
                   Classes="sample" />

        <TextBlock Grid.Row="6" Grid.Column="0"
                   Text="Twemoji 36"
                   Classes="name" />
        <TextBlock Grid.Row="6" Grid.Column="1"
                   Text="😄🍕🚀🍣💻🎮🍓🐧"
                   FontFamily="{StaticResource Emoji}"
                   FontSize="36"
                   Classes="sample" />
    </Grid>

</UserControl>
