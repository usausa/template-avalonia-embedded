<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.EmbeddedApp.Views.Main"
             xmlns:state="clr-namespace:Template.EmbeddedApp.State"
             xmlns:services="clr-namespace:Template.EmbeddedApp.Services"
             mc:Ignorable="d"
             x:Class="Template.EmbeddedApp.Views.Main.DashboardView"
             x:DataType="local:DashboardViewModel"
             s:DataContextResolver.Type="local:DashboardViewModel"
             d:DesignWidth="800" d:DesignHeight="480">

    <UserControl.Styles>
        <Style Selector="TextBlock.core">
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="8"
          RowSpacing="8">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <TextBlock Grid.Column="0"
                       Text="Dashboard"
                       Classes="title" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding Model, TargetNullValue=-}"
                       Classes="note" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="20">
                <TextBlock.Text>
                    <Binding Path="Uptime"
                             StringFormat="Uptime {0:d\.hh\:mm\:ss}"
                             TargetNullValue="Uptime -" />
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="300,*"
              ColumnSpacing="8">

            <Border Grid.Column="0"
                    Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="SoC"
                               Classes="card-title" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F1}', TargetNullValue='--.-'}"
                                   FontFamily="{StaticResource Dseg7}"
                                   FontSize="44" />
                        <TextBlock VerticalAlignment="Bottom"
                                   Text="°C" />
                    </StackPanel>
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="100,*"
                          RowSpacing="2">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="ARM"
                                   Classes="label" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ArmClockMegahertz, StringFormat='{}{0:F0} MHz', TargetNullValue=-}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Core"
                                   Classes="label" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding CoreClockMegahertz, StringFormat='{}{0:F0} MHz', TargetNullValue=-}" />
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Voltage"
                                   Classes="label" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding CoreVoltage, StringFormat='{}{0:F3} V', TargetNullValue=-}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Indicators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:IndicatorItem">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,1"
                                            Spacing="8">
                                    <Ellipse Classes="dot"
                                             Classes.active="{Binding IsActive}"
                                             Classes.occurred="{Binding HasOccurred}"
                                             Classes.off="{Binding !HasValue}" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="20" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock IsVisible="{Binding !IsRaspberrySupported}"
                               Text="Raspberry Pi only (RaspberryDotNet)"
                               Classes="note" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Classes="card">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="4">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="System"
                                   Classes="card-title" />
                        <ContentControl Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{Binding Information}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="services:SystemInformation">
                                    <TextBlock Classes="note" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}  {1}  {2}">
                                                <Binding Path="HostName" />
                                                <Binding Path="OperatingSystem" />
                                                <Binding Path="Kernel" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                    <ContentControl Grid.Row="1"
                                    Content="{Binding SystemUsage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="local:SystemUsage">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="96,*,176"
                                      ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="CPU"
                                               Classes="label" />
                                    <ProgressBar Grid.Row="0" Grid.Column="1"
                                                 Value="{Binding CpuUsage}"
                                                 Maximum="100" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               Text="{Binding CpuUsage, StringFormat='{}{0:F1} %'}" />
                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                  ItemsSource="{Binding Cores}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:CoreUsage">
                                                <Grid ColumnDefinitions="96,*,176"
                                                      Margin="0,1"
                                                      ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Index, StringFormat='CPU{0}'}"
                                                               Classes="label core" />
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Usage}"
                                                                 Maximum="100" />
                                                    <TextBlock Grid.Column="2"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding Usage, StringFormat='{}{0:F1} %'}"
                                                               Classes="core" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Memory"
                                               Classes="label" />
                                    <ProgressBar Grid.Row="2" Grid.Column="1"
                                                 Value="{Binding MemoryUsage}"
                                                 Maximum="100" />
                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               HorizontalAlignment="Right">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F0} / {1:F0} MB">
                                                <Binding Path="MemoryUsedMegabytes" />
                                                <Binding Path="MemoryTotalMegabytes" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="Disk"
                                               Classes="label" />
                                    <ProgressBar Grid.Row="3" Grid.Column="1"
                                                 Value="{Binding DiskUsage}"
                                                 Maximum="100" />
                                    <TextBlock Grid.Row="3" Grid.Column="2"
                                               HorizontalAlignment="Right">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F1} / {1:F1} GB">
                                                <Binding Path="DiskUsedGigabytes" />
                                                <Binding Path="DiskTotalGigabytes" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="Load"
                                               Classes="label" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F2}  {1:F2}  {2:F2}">
                                                <Binding Path="LoadAverage1" />
                                                <Binding Path="LoadAverage5" />
                                                <Binding Path="LoadAverage15" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="Network"
                                               Classes="label" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="RX {0:F1}  TX {1:F1} KB/s">
                                                <Binding Path="ReceiveKilobytes" />
                                                <Binding Path="TransmitKilobytes" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                               Text="Wi-Fi"
                                               Classes="label" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding SignalLevel, StringFormat='{}{0:F0} dBm', TargetNullValue=-}" />
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding !IsSystemSupported}"
                               Text="Linux only (LinuxDotNet)"
                               Classes="note" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="16">
            <TextBlock Text="Devices"
                       FontSize="20"
                       FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="state:DeviceStatus">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Ellipse Classes="dot"
                                     Classes.off="{Binding !IsConnected}" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="20" />
                            <TextBlock Text="{Binding Condition}"
                                       FontSize="20"
                                       Classes="label" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>

</UserControl>
