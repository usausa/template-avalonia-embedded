<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.EmbeddedApp.Controls"
             xmlns:module="clr-namespace:Template.EmbeddedApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.EmbeddedApp.Views.Main.MonitorView"
             x:DataType="module:MonitorViewModel"
             s:DataContextResolver.Type="module:MonitorViewModel"
             d:DesignWidth="800" d:DesignHeight="480">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TrackBrush"
                         Color="{StaticResource GrayLighten3}" />
        <SolidColorBrush x:Key="GridBrush"
                         Color="{StaticResource GrayLighten2}" />
        <SolidColorBrush x:Key="CpuBrush"
                         Color="{StaticResource BlueDefault}" />
        <SolidColorBrush x:Key="TemperatureBrush"
                         Color="{StaticResource OrangeDefault}" />
        <SolidColorBrush x:Key="MemoryBrush"
                         Color="{StaticResource GreenDefault}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.digit">
            <Setter Property="FontFamily" Value="{StaticResource Dseg7}" />
            <Setter Property="FontSize" Value="38" />
        </Style>
        <Style Selector="TextBlock.legend">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="controls|ArcGauge">
            <Setter Property="Thickness" Value="16" />
            <Setter Property="TrackBrush" Value="{StaticResource TrackBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,210,*"
          Margin="8"
          RowSpacing="8">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12">
            <TextBlock Classes="title"
                       Text="Monitor" />
            <TextBlock Classes="note"
                       VerticalAlignment="Center"
                       Text="LinuxDotNet / RaspberryDotNet" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding IsDemo}"
                       Text="Demo data (Linux only)"
                       FontSize="18"
                       Foreground="{StaticResource TemperatureBrush}" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
            <Border Grid.Column="0"
                    Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Classes="card-title"
                               Text="CPU" />
                    <controls:ArcGauge Grid.Row="1"
                                       Maximum="100"
                                       Level="{Binding Cpu, TargetNullValue=0}"
                                       ValueBrush="{StaticResource CpuBrush}" />
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="digit"
                                   Text="{Binding Cpu, StringFormat='{}{0:F0}', TargetNullValue=--}" />
                        <TextBlock VerticalAlignment="Bottom"
                                   Text="%" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Classes="card-title"
                               Text="Temperature" />
                    <controls:ArcGauge Grid.Row="1"
                                       Maximum="100"
                                       Level="{Binding Temperature, TargetNullValue=0}"
                                       ValueBrush="{StaticResource TemperatureBrush}" />
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="digit"
                                   Text="{Binding Temperature, StringFormat='{}{0:F1}', TargetNullValue='--.-'}" />
                        <TextBlock VerticalAlignment="Bottom"
                                   Text="°C" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2"
                    Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Classes="card-title"
                               Text="Memory" />
                    <controls:ArcGauge Grid.Row="1"
                                       Maximum="100"
                                       Level="{Binding Memory, TargetNullValue=0}"
                                       ValueBrush="{StaticResource MemoryBrush}" />
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="digit"
                                   Text="{Binding Memory, StringFormat='{}{0:F0}', TargetNullValue=--}" />
                        <TextBlock VerticalAlignment="Bottom"
                                   Text="%" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="card">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="4">
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="16">
                    <TextBlock Classes="card-title"
                               Text="Trend (60 s)" />
                    <TextBlock Classes="legend"
                               Text="CPU %"
                               Foreground="{StaticResource CpuBrush}" />
                    <TextBlock Classes="legend"
                               Text="Temperature °C"
                               Foreground="{StaticResource TemperatureBrush}" />
                    <TextBlock Classes="legend"
                               Text="Memory %"
                               Foreground="{StaticResource MemoryBrush}" />
                </StackPanel>
                <controls:TrendChart Grid.Row="1"
                                     Stroke="{StaticResource MemoryBrush}"
                                     Capacity="{x:Static module:MonitorViewModel.HistoryLength}"
                                     GridBrush="{StaticResource GridBrush}"
                                     Values="{Binding MemoryValues}" />
                <controls:TrendChart Grid.Row="1"
                                     Stroke="{StaticResource TemperatureBrush}"
                                     Capacity="{x:Static module:MonitorViewModel.HistoryLength}"
                                     Values="{Binding TemperatureValues}" />
                <controls:TrendChart Grid.Row="1"
                                     Stroke="{StaticResource CpuBrush}"
                                     Capacity="{x:Static module:MonitorViewModel.HistoryLength}"
                                     Values="{Binding CpuValues}" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
