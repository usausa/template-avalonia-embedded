<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="http://smart/avalonia"
        xmlns:application="using:Template.EmbeddedApp"
        xmlns:state="using:Template.EmbeddedApp.State"
        xmlns:module="using:Template.EmbeddedApp.Views.Main"
        mc:Ignorable="d"
        x:Class="Template.EmbeddedApp.DebugWindow"
        x:DataType="application:DebugWindowViewModel"
        s:DataContextResolver.Type="application:DebugWindowViewModel"
        d:DesignWidth="1080" d:DesignHeight="520"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        Title="Debug"
        Icon="/Assets/avalonia-logo.ico">

    <Window.Styles>
        <Style Selector="Border.key">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource GrayLighten2}" />
        </Style>
        <Style Selector="Border.key.pressed">
            <Setter Property="Background" Value="{StaticResource BlueLighten2}" />
        </Style>
        <Style Selector="TextBlock.panel-title">
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource GrayLighten4}">
            <ItemsControl ItemsSource="{Binding Keys}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="application:DebugKey">
                        <Border Classes="key"
                                Classes.pressed="{Binding IsPressed}"
                                PointerPressed="OnKeyPointerPressed" PointerReleased="OnKeyPointerReleased" PointerCaptureLost="OnKeyPointerCaptureLost">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1}">
                                        <Binding Path="Number" />
                                        <Binding Path="Key" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border DockPanel.Dock="Right"
                Width="280"
                Height="{Binding ScreenHeight}"
                Padding="8"
                Background="{StaticResource GrayLighten5}">
            <StackPanel>
                <ToggleButton Command="{Binding ConnectCommand}"
                              CommandParameter="{Binding $self.IsChecked}"
                              IsChecked="True"
                              Content="Input connected" />
                <TextBlock Classes="panel-title"
                           Text="Devices" />
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="state:DeviceStatus">
                            <Grid ColumnDefinitions="100,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Condition}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="panel-title"
                           Text="Inputs" />
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="module:InputRecord">
                            <Grid ColumnDefinitions="90,72,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding At, StringFormat={}{0:HH:mm:ss.fff}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Key}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Action}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Width="{Binding ScreenWidth}"
                Height="{Binding ScreenHeight}">
            <application:MainView />
        </Border>

    </DockPanel>

</Window>
