<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector=":is(UserControl).screen">
        <Setter Property="Background" Value="{StaticResource GrayLighten4}" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource GrayDarken1}" />
    </Style>
    <Style Selector="TextBlock.note">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource GrayDarken1}" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource GrayLighten1}" />
    </Style>
    <Style Selector="Border.hint">
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Border.hint.on">
        <Setter Property="Background" Value="{StaticResource BlueLighten2}" />
    </Style>
    <Style Selector="Border.hint TextBlock">
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource GreenDefault}" />
    </Style>
    <Style Selector="Ellipse.dot.occurred">
        <Setter Property="Fill" Value="{StaticResource AmberDefault}" />
    </Style>
    <Style Selector="Ellipse.dot.active">
        <Setter Property="Fill" Value="{StaticResource RedDefault}" />
    </Style>
    <Style Selector="Ellipse.dot.off">
        <Setter Property="Fill" Value="{StaticResource GrayLighten1}" />
    </Style>
    <Style Selector="ProgressBar:horizontal">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
