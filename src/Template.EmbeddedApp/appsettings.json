{
  "Setting": {
    "Value": "Production"
  },

  "Display": {
    "Device": "/dev/dri/card1",
    "Scaling": 1
  },

  "Input": {
    "Type": "Pad",
    "Profile": "Default",
    "PadDevice": "/dev/input/js0",
    "Profiles": {
      "Default": {
        "Gpio": [
          { "Pin": 5, "Key": "Button1", "ActiveLow": true, "DebounceMilliseconds": 50, "MinimumIntervalMilliseconds": 300 },
          { "Pin": 6, "Key": "Button2", "ActiveLow": true, "DebounceMilliseconds": 50, "MinimumIntervalMilliseconds": 300 },
          { "Pin": 13, "Key": "Button3", "ActiveLow": true, "DebounceMilliseconds": 50, "RepeatDelayMilliseconds": 500, "RepeatIntervalMilliseconds": 100 },
          { "Pin": 19, "Key": "Button4", "ActiveLow": true, "DebounceMilliseconds": 50, "LongPressMilliseconds": 1000 }
        ],
        "Pad": [
          { "Button": 0, "Key": "Button1", "MinimumIntervalMilliseconds": 300 },
          { "Button": 1, "Key": "Button2", "MinimumIntervalMilliseconds": 300 },
          { "Button": 2, "Key": "Button3", "RepeatDelayMilliseconds": 500, "RepeatIntervalMilliseconds": 100 },
          { "Button": 3, "Key": "Button4", "LongPressMilliseconds": 1000 }
        ]
      },
      "ActiveHigh": {
        "Gpio": [
          { "Pin": 5, "Key": "Button1", "ActiveLow": false, "DebounceMilliseconds": 50, "MinimumIntervalMilliseconds": 300 },
          { "Pin": 6, "Key": "Button2", "ActiveLow": false, "DebounceMilliseconds": 50, "MinimumIntervalMilliseconds": 300 },
          { "Pin": 13, "Key": "Button3", "ActiveLow": false, "DebounceMilliseconds": 50, "RepeatDelayMilliseconds": 500, "RepeatIntervalMilliseconds": 100 },
          { "Pin": 19, "Key": "Button4", "ActiveLow": false, "DebounceMilliseconds": 50, "LongPressMilliseconds": 1000 }
        ]
      }
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Log/EmbeddedApp_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
