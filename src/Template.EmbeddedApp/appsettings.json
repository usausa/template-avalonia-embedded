{
  "Setting": {
    "Value": "Production"
  },

  "Display": {
    "Device": "/dev/dri/card1",
    "Scaling": 1
  },

  "Input": {
    "Type": "Pad"
  },

  "GpioInput": {
    "Pins": [ 5, 6, 13, 19 ],
    "DebounceMilliseconds": 50
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Log/EmbeddedApp_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
